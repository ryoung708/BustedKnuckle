   <rect class="part" x="190" y="120" width="70" height="50" rx="7"/><path d="M201 145 H249" stroke="#ff9f1c" stroke-width="5"/><text class="sub-label" x="225" y="190">FUSE</text>
   <circle cx="330" cy="145" r="6" fill="#ff9f1c"/><circle cx="405" cy="145" r="6" fill="#ff9f1c"/><path id="switchBlade" d="M330 145 L397 111" stroke="#ff9f1c" stroke-width="6" stroke-linecap="round"/><text class="sub-label" x="367" y="190">SWITCH</text>
   <rect class="part" x="525" y="115" width="120" height="90" rx="9"/><circle id="lampBulb" cx="585" cy="155" r="24" fill="#29343e" stroke="#ff9f1c" stroke-width="3"/><path d="M569 139 L601 171 M601 139 L569 171" stroke="#ffca7a" stroke-width="3"/><text class="sub-label" x="585" y="226">LAMP / LOAD</text>
