  </label>
  <label for="benchSwitch">Circuit switch
   <select id="benchSwitch"><option value="on">ON — operating</option><option value="off">OFF</option></select>
  </label>
  <label for="benchMode">Meter mode
   <select id="benchMode"><option value="voltage">DC voltage</option><option value="resistance">Resistance</option><option value="continuity">Continuity</option></select>
  </label>
