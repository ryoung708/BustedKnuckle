<script>
const lessons=[
{id:"basic",cat:"circuits",title:"How a basic circuit works",desc:"A complete path lets current flow through a load.",intro:"A working circuit needs a source, a complete path and a load. Open the switch and the path is broken.",svg:'<svg viewBox="0 0 700 230"><rect x="18" y="80" width="105" height="70" rx="8" fill="#25313d" stroke="#69b7e8" stroke-width="2"/><text x="70" y="110" fill="#fff" font-size="15" text-anchor="middle">BATTERY</text><text x="70" y="130" fill="#69b7e8" font-size="12" text-anchor="middle">SOURCE</text><path d="M123 100 H235 M280 100 H500 M610 100 H665 V190 H70 V150" stroke="#70c69a" stroke-width="5" fill="none" stroke-linecap="round"/><path d="M235 100 L275 72" stroke="#ff9f1c" stroke-width="6" stroke-linecap="round"/><circle cx="235" cy="100" r="5" fill="#ff9f1c"/><circle cx="280" cy="100" r="5" fill="#ff9f1c"/><rect x="500" y="72" width="110" height="56" rx="7" fill="#3b2b18" stroke="#ff9f1c" stroke-width="2"/><text x="555" y="105" fill="#fff" font-size="15" text-anchor="middle">LOAD</text><text x="255" y="42" fill="#ffb34d" font-size="13" text-anchor="middle">SWITCH</text><text x="350" y="220" fill="#a2afbc" font-size="13" text-anchor="middle">Complete path = current can flow</text></svg>',facts:[["Source","Provides electrical potential, such as a battery."],["Conductors","Carry current through the intended path."],["Load","Uses electrical energy: lamp, solenoid, motor."],["Return path","Completes the path back to the source."]],tip:"Voltage is a potential difference. Current is flow through a complete circuit. A voltage reading alone does not prove a circuit can carry its intended load.",q:"What happens when the switch opens?",a:["Current path is interrupted","The load gets more current"],correct:0,why:"Opening the switch breaks the path, so current stops in this simplified circuit."},
{id:"parallel",cat:"circuits",title:"Series vs. parallel",desc:"One path or multiple branches?",intro:"A series circuit has one current path. A parallel circuit has separate branches across the source.",svg:'<svg viewBox="0 0 700 230"><rect x="15" y="82" width="100" height="65" rx="8" fill="#25313d" stroke="#69b7e8" stroke-width="2"/><text x="65" y="120" fill="#fff" font-size="15" text-anchor="middle">SOURCE</text><path d="M115 105 H190 V48 H620 V180 H190 V105 M620 48 V180" stroke="#70c69a" stroke-width="5" fill="none"/><rect x="335" y="27" width="120" height="42" rx="7" fill="#3b2b18" stroke="#ff9f1c" stroke-width="2"/><rect x="335" y="158" width="120" height="42" rx="7" fill="#3b2b18" stroke="#ff9f1c" stroke-width="2"/><text x="395" y="54" fill="#fff" font-size="15" text-anchor="middle">LOAD A</text><text x="395" y="185" fill="#fff" font-size="15" text-anchor="middle">LOAD B</text><text x="245" y="18" fill="#a2afbc" font-size="12">BRANCH 1</text><text x="245" y="222" fill="#a2afbc" font-size="12">BRANCH 2</text></svg>',facts:[["Series","An open component can interrupt the entire path."],["Parallel","One branch can fail while another continues."],["Real vehicles","Shared feeds, splices and grounds add complexity."],["Diagnostic clue","Map the actual circuit before assuming what should be affected."]],tip:"Use the OEM wiring diagram. This simplified illustration is not a substitute for the vehicle's actual circuit topology.",q:"If one parallel branch opens, what can happen?",a:["All branches must stop","Other branches may still operate"],correct:1,why:"Other parallel branches can retain their own complete paths."},
{id:"voltage",cat:"meter",title:"Meter setup: voltage",desc:"Voltage is measured across two points.",intro:"For voltage, connect the meter in parallel across the two points being compared. Select the correct voltage mode.",svg:'<svg viewBox="0 0 700 230"><rect x="25" y="85" width="110" height="70" rx="8" fill="#25313d" stroke="#69b7e8" stroke-width="2"/><text x="80" y="125" fill="#fff" font-size="15" text-anchor="middle">BATTERY</text><path d="M135 110 H290 M410 110 H630 V185 H80 V155" stroke="#70c69a" stroke-width="5" fill="none"/><rect x="290" y="82" width="120" height="56" rx="8" fill="#3b2b18" stroke="#ff9f1c" stroke-width="2"/><text x="350" y="115" fill="#fff" font-size="15" text-anchor="middle">LOAD</text><path d="M290 55 V30 H410 V55" stroke="#69b7e8" stroke-width="3" fill="none"/><circle cx="290" cy="55" r="5" fill="#69b7e8"/><circle cx="410" cy="55" r="5" fill="#69b7e8"/><rect x="325" y="5" width="50" height="30" rx="5" fill="#1b3545" stroke="#69b7e8" stroke-width="2"/><text x="350" y="25" fill="#fff" font-size="14" text-anchor="middle">V</text><text x="350" y="220" fill="#a2afbc" font-size="13" text-anchor="middle">Meter across the two test points</text></svg>',facts:[["Black lead","Usually COM. Confirm the meter markings."],["Red lead","Use the voltage/ohms jack, not the current jack."],["Probe placement","Across the component or specified test points."],["Circuit state","Record key state, load state and exact test points."]],tip:"Never place a meter set to current directly across a battery or voltage source. That can create a short. Follow meter and OEM safety instructions.",q:"To measure voltage across a lamp, where do the probes go?",a:["Across the two sides of the lamp","In series by opening the wire"],correct:0,why:"Voltage is a difference between two points, so the meter goes across the component."},
{id:"resistance",cat:"meter",title:"Meter setup: resistance & continuity",desc:"Power off and isolate before resistance tests.",intro:"Resistance and continuity modes use the meter's internal test signal. Power down and isolate the circuit as specified before testing.",svg:'<svg viewBox="0 0 700 230"><path d="M55 120 H260 M390 120 H645" stroke="#70c69a" stroke-width="5" fill="none"/><path d="M260 120 L280 95 L300 145 L320 95 L340 145 L360 95 L390 120" stroke="#ff9f1c" stroke-width="4" fill="none"/><rect x="305" y="28" width="90" height="38" rx="5" fill="#1b3545" stroke="#69b7e8" stroke-width="2"/><text x="350" y="53" fill="#fff" font-size="16" text-anchor="middle">Ω</text><path d="M305 66 V90 H260 V120 M395 66 V90 H390 V120" stroke="#69b7e8" stroke-width="3" fill="none"/><text x="55" y="95" fill="#fff" font-size="14">ISOLATED</text><text x="645" y="95" fill="#fff" font-size="14" text-anchor="end">CIRCUIT</text><text x="350" y="195" fill="#a2afbc" font-size="13" text-anchor="middle">Power OFF • isolate • then measure</text></svg>',facts:[["Power OFF","Confirm de-energized using approved procedure."],["Isolate","Disconnect loads or branches as required."],["Measure","Place probes across the isolated conductor or component."],["Interpret","Compare with specification and account for parallel paths."]],tip:"Never use resistance or continuity mode on an energized circuit. A continuity beep does not prove a connection can carry operating current.",q:"Can continuity alone prove a connection is good under load?",a:["Yes, always","No, it can fail under load"],correct:1,why:"A loaded voltage-drop test can reveal resistance that a simple continuity check misses."},
{id:"drop",cat:"testing",title:"Voltage drop: test under load",desc:"Measure voltage lost while current flows.",intro:"Compare the two ends of a conductor or connection while the circuit is operating under the specified load.",svg:'<svg viewBox="0 0 700 230"><rect x="20" y="85" width="110" height="68" rx="8" fill="#25313d" stroke="#69b7e8" stroke-width="2"/><text x="75" y="125" fill="#fff" font-size="15" text-anchor="middle">SOURCE</text><path d="M130 112 H280 M380 112 H640 V185 H75 V153" stroke="#70c69a" stroke-width="5" fill="none"/><rect x="280" y="82" width="100" height="60" rx="7" fill="#5a271e" stroke="#ff9f1c" stroke-width="2"/><path d="M293 95 L367 129 M293 129 L367 95" stroke="#ffb34d" stroke-width="3"/><path d="M280 55 V30 H380 V55" stroke="#69b7e8" stroke-width="3" fill="none"/><rect x="310" y="5" width="40" height="30" rx="5" fill="#1b3545" stroke="#69b7e8" stroke-width="2"/><text x="330" y="25" fill="#fff" font-size="14" text-anchor="middle">V</text><text x="330" y="175" fill="#ffb34d" font-size="13" text-anchor="middle">CONNECTION</text><text x="350" y="220" fill="#a2afbc" font-size="13" text-anchor="middle">Measure across the section while loaded</text></svg>',facts:[["Set up","Reproduce the operating condition and load safely."],["Probe","Place the meter across the section being evaluated."],["Read","The meter shows potential difference across that section."],["Localize","Test smaller sections. Compare with OEM limits."]],tip:"There is no universal pass/fail voltage-drop number for every heavy-duty circuit. Use the exact OEM specification, load and test points.",q:"Why should the circuit be loaded during a voltage-drop test?",a:["To make current flow through the connection","To make the meter read battery voltage"],correct:0,why:"The test reveals voltage lost while current is flowing through the path."},
{id:"isolate",cat:"testing",title:"Finding a short: isolate in sections",desc:"Separate branches methodically. Don't guess.",intro:"With the circuit safely isolated, use the wiring diagram to divide it into known sections. Change one variable at a time.",svg:'<svg viewBox="0 0 700 230"><rect x="20" y="82" width="115" height="70" rx="8" fill="#25313d" stroke="#69b7e8" stroke-width="2"/><text x="77" y="122" fill="#fff" font-size="15" text-anchor="middle">SOURCE</text><path d="M135 110 H220 V50 H350 M220 110 V185 H350" stroke="#70c69a" stroke-width="5" fill="none"/><rect x="350" y="28" width="120" height="45" rx="7" fill="#3b2b18" stroke="#ff9f1c" stroke-width="2"/><rect x="350" y="163" width="120" height="45" rx="7" fill="#3b2b18" stroke="#ff9f1c" stroke-width="2"/><text x="410" y="56" fill="#fff" font-size="15" text-anchor="middle">BRANCH A</text><text x="410" y="191" fill="#fff" font-size="15" text-anchor="middle">BRANCH B</text><path d="M470 50 H610 V185 H470" stroke="#70c69a" stroke-width="5" fill="none"/><text x="555" y="25" fill="#a2afbc" font-size="12" text-anchor="middle">Separate at known points</text><text x="555" y="220" fill="#a2afbc" font-size="12" text-anchor="middle">One variable at a time</text></svg>',facts:[["Identify","Confirm the circuit and correct protection device."],["Make safe","Follow OEM power-down and isolation instructions."],["Divide","Separate at documented connectors or branch points."],["Verify","A change identifies an area to investigate, not a failed part."]],tip:"Do not unplug modules or probe network circuits randomly. Follow OEM isolation procedures and document each configuration.",q:"If the symptom disappears after disconnecting a branch, what have you proved?",a:["The component is definitely bad","That branch is implicated and needs inspection"],correct:1,why:"Isolation narrows the suspect area. Wiring, connector, power, ground or the connected device may be involved."}
];
let active="basic",filter="all";const list=document.getElementById("lessonList"),panel=document.getElementById("lessonPanel");
function render(){list.innerHTML="";lessons.filter(x=>filter==="all"||x.cat===filter).forEach(x=>{const b=document.createElement("button");b.className="choice"+(x.id===active?" active":"");b.innerHTML="<b>"+x.title+"</b><small>"+x.desc+"</small>";b.onclick=()=>{active=x.id;render()};list.appendChild(b)});const l=lessons.find(x=>x.id===active);panel.innerHTML='<div class="eyebrow">'+l.cat.toUpperCase()+'</div><h2>'+l.title+'</h2><p class="intro">'+l.intro+'</p><div class="diagram">'+l.svg+'<p class="note">Simplified educational illustration. Use the correct vehicle wiring diagram and OEM procedure for actual testing.</p></div><div class="facts">'+l.facts.map(x=>'<div class="fact"><b>'+x[0]+'</b><p>'+x[1]+'</p></div>').join("")+'</div><div class="tip '+(l.cat==="meter"||l.cat==="testing"?"warn":"")+'">'+l.tip+'</div><section class="quiz"><h3>'+l.q+'</h3><div class="answers">'+l.a.map((x,i)=>'<button data-a="'+i+'">'+x+'</button>').join("")+'</div><div class="feedback" id="feedback">Quick check: choose an answer.</div></section>';panel.querySelectorAll("[data-a]").forEach(b=>b.onclick=()=>{const ok=Number(b.dataset.a)===l.correct;const f=document.getElementById("feedback");f.textContent=(ok?"Correct. ":"Not quite. ")+l.why;f.style.color=ok?"#70c69a":"#ffb34d"})}

const benchFault=document.getElementById("benchFault"),benchSwitch=document.getElementById("benchSwitch"),benchMode=document.getElementById("benchMode"),batteryIsolation=document.getElementById("batteryIsolation");
let activeProbe="red",probeRed="battery",probeBlack="negative";
const nodeNames={battery:"Battery positive (+)",fuseIn:"Fuse input",fuseOut:"Fuse output",switchIn:"Switch input",switch:"Switch output",load:"Load input",loadOut:"Load output",ground:"Ground return",negative:"Battery negative (−)"};
const probeCoords={battery:[115,145],fuseIn:[190,145],fuseOut:[260,145],switchIn:[330,145],switch:[405,145],load:[525,145],loadOut:[585,205],ground:[585,275],negative:[115,275]};
function drawProbeLeads(){
 const [rx,ry]=probeCoords[probeRed],[bx,by]=probeCoords[probeBlack];
 const redStart=[245,345],blackStart=[315,345];
 document.getElementById("redLead").setAttribute("d",`M${redStart[0]} ${redStart[1]} Q${(redStart[0]+rx)/2-18} ${Math.max(35,(redStart[1]+ry)/2-35)} ${rx} ${ry}`);
 document.getElementById("blackLead").setAttribute("d",`M${blackStart[0]} ${blackStart[1]} Q${(blackStart[0]+bx)/2+18} ${Math.max(35,(blackStart[1]+by)/2-25)} ${bx} ${by}`);
 document.getElementById("redTip").setAttribute("cx",rx);document.getElementById("redTip").setAttribute("cy",ry);
 document.getElementById("blackTip").setAttribute("cx",bx);document.getElementById("blackTip").setAttribute("cy",by);
 document.getElementById("redTag").setAttribute("x",Math.min(675,rx+13));document.getElementById("redTag").setAttribute("y",ry-12);
 document.getElementById("blackTag").setAttribute("x",Math.min(675,bx+13));document.getElementById("blackTag").setAttribute("y",by+20);
 document.getElementById("activeProbeHint").textContent=(activeProbe==="red"?"RED":"BLACK")+" lead selected — click a test point.";
}
function benchModel(){
 const fault=benchFault.value,on=benchSwitch.value==="on",mode=benchMode.value,batteryIsolated=batteryIsolation.value==="isolated";
 const fuseOpen=fault==="fuse"||fault==="short";
 const nodes=Object.keys(nodeNames);
 const resistors=[];
 const add=(from,to,ohms,id)=>{if(Number.isFinite(ohms)&&ohms>0)resistors.push({from,to,ohms,id});};
 add("battery","fuseIn",0.1,"battery-feed");
 add("fuseIn","fuseOut",fuseOpen?null:0.1,"fuse");
 add("fuseOut","switchIn",fault==="open"?null:(fault==="resistive"?1.5:0.1),"feed-wire");
 add("switchIn","switch",on?0.1:null,"switch");
 add("switch","load",0.1,"load-feed");
 add("load","loadOut",3.0,"lamp");
 // Put the ground fault in the return conductor itself. The chassis-side
 // node remains connected when the battery negative post is isolated.
 add("loadOut","ground",fault==="ground"?4.8:0.1,"ground-connection");
 add("ground","negative",0.1,"battery-negative-cable");
 if(fault==="short")add("load","ground",0.1,"short-to-ground");

 function solveNetwork(branches, fixedVoltages, injections={}){
  const active=new Set(Object.keys(fixedVoltages)),queue=[...active];
  while(queue.length){
   const here=queue.shift();
   for(const edge of branches){
    const next=edge.from===here?edge.to:(edge.to===here?edge.from:null);
    if(next!==null&&!active.has(next)){active.add(next);queue.push(next);}
   }
  }
  for(const id of Object.keys(injections))if(!active.has(id))throw new Error("Probe point is separated by an open circuit");
  const unknown=nodes.filter(n=>active.has(n)&&!(n in fixedVoltages));
  const idx=new Map(unknown.map((n,i)=>[n,i]));
  const matrix=unknown.map(()=>unknown.map(()=>0)),rhs=unknown.map(n=>injections[n]||0);
  for(const e of branches){
   const g=1/e.ohms,i=idx.get(e.from),j=idx.get(e.to);
   if(i!==undefined){matrix[i][i]+=g;if(j!==undefined)matrix[i][j]-=g;else rhs[i]+=g*fixedVoltages[e.to];}
   if(j!==undefined){matrix[j][j]+=g;if(i!==undefined)matrix[j][i]-=g;else rhs[j]+=g*fixedVoltages[e.from];}
  }
  const n=rhs.length,a=matrix.map((row,i)=>[...row,rhs[i]]);
  for(let c=0;c<n;c++){
   let p=c;for(let r=c+1;r<n;r++)if(Math.abs(a[r][c])>Math.abs(a[p][c]))p=r;
   if(Math.abs(a[p][c])<1e-12)throw new Error("Floating node");
   [a[c],a[p]]=[a[p],a[c]];
   const d=a[c][c];for(let j=c;j<=n;j++)a[c][j]/=d;
   for(let r=0;r<n;r++){if(r===c)continue;const k=a[r][c];for(let j=c;j<=n;j++)a[r][j]-=k*a[c][j];}
  }
  const result={...fixedVoltages};unknown.forEach((id,i)=>result[id]=a[i][n]);return result;
 }
 function equivalentResistance(from,to){
  if(from===to)return 0;
  const injected=solveNetwork(resistors,{[to]:0},{[from]:1,[to]:-1});
  return injected[from];
 }
 let volts={battery:12.6,negative:0};
 let totalCurrent=0, lampVoltage=0,groundDrop=0;
 if(on&&!fuseOpen&&fault!=="open"){
  try{
   volts=solveNetwork(resistors,{battery:12.6,negative:0});
   totalCurrent=(volts.load-volts.loadOut)/3.0;
   lampVoltage=volts.load-volts.loadOut;
   groundDrop=volts.loadOut-volts.ground;
  }catch(_){ }
 }else{
  // Unpowered downstream nodes are not assigned an artificial live voltage.
  volts={battery:12.6,fuseIn:12.59,fuseOut:fuseOpen?0:12.49,switchIn:fault==="open"?0:(fuseOpen?0:12.39),switch:0,load:0,loadOut:0,ground:0,negative:0};
 }
 const lampOn=on&&!batteryIsolated&&totalCurrent>0;
 const brightness=Math.max(0,Math.min(1,totalCurrent/(12.6/(0.1+0.1+0.1+0.1+3.0+0.1+0.1))));
 const bulb=document.getElementById("lampBulb");
 bulb.setAttribute("fill",lampOn?"#ffca7a":"#29343e");
 bulb.setAttribute("filter",lampOn&&brightness>0.08?"url(#lampGlow)":"");
 bulb.setAttribute("opacity",lampOn?String(0.25+0.75*brightness):"1");
 document.getElementById("lampState").textContent=lampOn?"LAMP ON — "+Math.round(brightness*100)+"% BRIGHTNESS":(fault==="short"?"FUSE OPENED — LAMP OFF":"LAMP OFF");
 ["feedA","feedB","feedC","returnA"].forEach(id=>{
  const el=document.getElementById(id);
  el.classList.toggle("live",on&&totalCurrent>0);
  el.classList.toggle("fault",(fault==="open"&&id==="feedB")||(fault==="resistive"&&id==="feedB")||(fault==="ground"&&id==="returnA")||(fuseOpen&&id==="feedA"));
 });
 document.getElementById("switchBlade").setAttribute("d",on?"M330 145 L397 145":"M330 145 L397 111");
 document.querySelectorAll(".probe-point").forEach(p=>{p.classList.toggle("red",p.dataset.point===probeRed);p.classList.toggle("black",p.dataset.point===probeBlack);});
 drawProbeLeads();
 const status=document.getElementById("benchStatus"),reading=document.getElementById("benchReading"),explain=document.getElementById("benchExplain");
 if(mode!=="voltage"&&!batteryIsolated){
  reading.textContent="—";document.getElementById("benchMeterMode").textContent=mode==="resistance"?"OHMS":"CONTINUITY";
  status.className="bench-status warn";status.textContent="Safety interlock: disconnect battery negative before resistance or continuity testing.";
  explain.textContent="Resistance and continuity require a de-energized, isolated circuit. Select Disconnected — circuit isolated. The ground fault is modeled in the return conductor between load output (G) and chassis ground (H); it remains measurable with the battery negative post isolated.";
  return;
 }
 if(mode==="voltage"){
  document.getElementById("benchMeterMode").textContent="DC VOLTS";
  let red=volts[probeRed]??0,black=volts[probeBlack]??0;
  const delta=red-black;
  reading.textContent=(Math.abs(delta)<0.05?"0.0":delta.toFixed(2))+" V";
  explain.textContent="Red: "+nodeNames[probeRed]+" ("+red.toFixed(2)+" V). Black: "+nodeNames[probeBlack]+" ("+black.toFixed(2)+" V). Meter displays red minus black. Simulated load current: "+totalCurrent.toFixed(2)+" A. Lamp voltage: "+lampVoltage.toFixed(2)+" V. Ground-side drop (G to H): "+groundDrop.toFixed(2)+" V.";
 }else{
  document.getElementById("benchMeterMode").textContent=mode==="resistance"?"OHMS":"CONTINUITY";
  let ohms=Infinity;
  try{ohms=equivalentResistance(probeRed,probeBlack);}catch(_){ohms=Infinity;}
  const hasPath=Number.isFinite(ohms);
  reading.textContent=mode==="resistance"?(hasPath?ohms.toFixed(2)+" Ω":"OL"):(hasPath?(ohms<=5?"BEEP":"HIGH RESISTANCE"):"OPEN");
  explain.style.whiteSpace="pre-line";
  explain.textContent="Isolated-circuit equivalent resistance from "+nodeNames[probeRed]+" to "+nodeNames[probeBlack]+": "+(hasPath?ohms.toFixed(2)+" Ω":"OL — no connected path.")+"\n\nThis is the network's equivalent resistance, including parallel paths—not just the lowest-resistance route. The poor-ground fault adds 4.8 Ω between load output (G) and chassis ground (H), so probes across G-H show that resistance. Point I represents the detached battery-negative cable lug, not the battery post; the cable between chassis ground (H) and lug (I) remains measurable. The battery itself is isolated at the post-to-lug connection.";
 }
 status.className="bench-status";
 const faultText={
  good:"Healthy circuit. Operating current and voltage are calculated from the same resistor network.",
  open:"Open feed selected between fuse output (C) and switch input (D). The load receives no operating current.",
  resistive:"Added 1.5 Ω feed connection resistance. Under load it reduces current and creates a measurable voltage drop.",
  ground:"Poor ground selected: 4.8 Ω added between load output (G) and chassis ground (H). Under load, current falls, the ground side rises above battery negative, and the lamp dims. With power isolated, G-to-H resistance measures 4.8 Ω.",
  fuse:"Open fuse selected. The downstream load is disconnected from battery positive.",
  short:"Short-to-ground selected downstream of the fuse. The protective fuse opens in this simplified training scenario."
 };
 status.textContent=faultText[fault];
}
document.querySelectorAll(".probe-point").forEach(point=>point.addEventListener("click",()=>{if(activeProbe==="red")probeRed=point.dataset.point;else probeBlack=point.dataset.point;benchModel()}));
document.getElementById("selectRed").addEventListener("click",()=>{activeProbe="red";document.getElementById("selectRed").classList.add("active");document.getElementById("selectBlack").classList.remove("active")});
document.getElementById("selectBlack").addEventListener("click",()=>{activeProbe="black";document.getElementById("selectBlack").classList.add("active");document.getElementById("selectRed").classList.remove("active");drawProbeLeads()});
document.getElementById("resetProbes").addEventListener("click",()=>{probeRed="battery";probeBlack="negative";benchModel()});
[benchFault,benchSwitch,benchMode,batteryIsolation].forEach(el=>el.addEventListener("change",benchModel));
benchModel();

document.querySelectorAll(".tab").forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelectorAll(".tab").forEach(t=>t.classList.toggle("active",t===b));const first=lessons.find(x=>filter==="all"||x.cat===filter);if(first)active=first.id;render()});render();
</script></body></html>