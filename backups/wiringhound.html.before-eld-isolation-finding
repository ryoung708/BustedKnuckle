<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090b0e">
<title>WiringHound // IronKnuckle Diagnostics</title>
<style>
:root{color-scheme:dark;--bg:#090b0e;--panel:#11171e;--raised:#1a232d;--line:#354352;--amber:#ff9f1c;--text:#f1f4f7;--muted:#9aa8b6;--green:#71d3a0;--red:#ff6868;--blue:#78bfff}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% -15%,#ff9f1c18,transparent 42%),var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif}
button,input,select{font:inherit}a{color:inherit}.wrap{width:min(1380px,100%);margin:auto;padding:22px 26px 60px}
header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding-bottom:18px;border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:13px}.hound-mark{width:46px;height:46px;border:1px solid #ff9f1c88;border-radius:12px;display:grid;place-items:center;color:var(--amber);font-size:26px;background:#ff9f1c12;box-shadow:0 0 25px #ff9f1c18}
.brand strong{display:block;font-size:17px;letter-spacing:.12em}.brand small{display:block;color:var(--muted);font-size:10px;letter-spacing:.18em;margin-top:4px}
.back{color:var(--muted);text-decoration:none;font-size:12px;font-weight:800;border:1px solid var(--line);padding:10px 13px;border-radius:8px}.back:hover{color:var(--amber);border-color:var(--amber)}
.hero{padding:28px 0 22px;display:flex;justify-content:space-between;gap:20px;align-items:end}.eyebrow{color:var(--amber);font-size:10px;font-weight:900;letter-spacing:.2em;text-transform:uppercase}.hero h1{font-size:clamp(30px,5vw,52px);line-height:1;margin:9px 0 10px;letter-spacing:-.055em}.hero p{max-width:720px;color:var(--muted);line-height:1.6;margin:0;font-size:14px}.live{white-space:nowrap;border:1px solid #71d3a055;color:var(--green);border-radius:99px;padding:9px 12px;font-size:10px;font-weight:900;letter-spacing:.12em}
.disclaimer{padding:12px 15px;background:#ff9f1c0d;border:1px solid #ff9f1c44;border-radius:9px;color:#d6c4a8;font-size:12px;line-height:1.55;margin-bottom:18px}.disclaimer b{color:var(--amber)}
.grid{display:grid;grid-template-columns:minmax(250px,.78fr) minmax(0,1.65fr);gap:16px;align-items:start}.panel{background:linear-gradient(180deg,#ffffff05,transparent 45%),var(--panel);border:1px solid var(--line);border-radius:12px;padding:18px;box-shadow:0 15px 40px #0005}.panel h2{margin:0;font-size:13px;letter-spacing:.12em;text-transform:uppercase}.sub{color:var(--muted);font-size:11px;line-height:1.5;margin:7px 0 15px}
.progress{display:flex;gap:5px;margin:14px 0 18px}.progress i{height:4px;flex:1;background:#34414e;border-radius:9px}.progress i.done{background:var(--amber);box-shadow:0 0 10px #ff9f1c66}
.step-list{display:grid;gap:7px}.step-nav{display:flex;align-items:center;gap:10px;width:100%;text-align:left;padding:11px;background:var(--raised);border:1px solid transparent;border-radius:8px;color:var(--muted);cursor:pointer}.step-nav .num{width:24px;height:24px;display:grid;place-items:center;border-radius:7px;background:#0d1218;font-size:10px;font-weight:900}.step-nav span:last-child{font-size:11px;font-weight:800;letter-spacing:.04em}.step-nav.active{border-color:var(--amber);color:var(--text);background:#ff9f1c15}.step-nav.complete .num{background:#1c4a35;color:var(--green)}
.stage-head{display:flex;justify-content:space-between;gap:12px;align-items:start;margin-bottom:16px}.stage-kicker{font-size:10px;color:var(--amber);font-weight:900;letter-spacing:.16em;text-transform:uppercase}.stage-title{font-size:24px;margin:5px 0 6px;letter-spacing:-.035em}.stage-copy{font-size:13px;color:var(--muted);line-height:1.6;margin:0;max-width:700px}.tag{font-size:9px;letter-spacing:.12em;font-weight:900;border:1px solid var(--line);color:var(--muted);padding:7px 9px;border-radius:99px;white-space:nowrap}
.test-card{background:#0c1117;border:1px solid #354352;border-radius:10px;padding:15px;margin:14px 0}.test-card h3{font-size:11px;letter-spacing:.12em;text-transform:uppercase;margin:0 0 10px;color:#dce4eb}.test-card p{font-size:12px;line-height:1.6;color:var(--muted);margin:7px 0}.test-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.test-cell{padding:12px;background:#151d26;border-radius:8px}.test-cell b{display:block;font-size:11px;color:var(--amber);margin-bottom:5px}.test-cell span{font-size:12px;color:#dce4eb}
.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.choice,.next,.reset{border:1px solid var(--line);background:var(--raised);color:var(--text);padding:11px 13px;border-radius:8px;font-size:11px;font-weight:850;cursor:pointer}.choice:hover,.next:hover,.reset:hover{border-color:var(--amber)}.choice.selected{border-color:var(--amber);background:#ff9f1c1a;color:var(--amber)}.next{background:var(--amber);color:#15100a;border-color:var(--amber)}.next:disabled{opacity:.35;cursor:not-allowed}.reset{color:var(--muted)}
.result{margin-top:14px;padding:13px;border:1px solid #71d3a055;background:#71d3a00b;border-radius:8px;font-size:12px;line-height:1.6;color:#d8e8df}.result strong{color:var(--green)}
.note{font-size:11px;color:var(--muted);line-height:1.6;margin-top:12px}.field{display:grid;gap:6px;margin:10px 0}.field label{font-size:10px;color:var(--muted);font-weight:850;letter-spacing:.1em;text-transform:uppercase}.field input,.field select{width:100%;padding:11px;color:var(--text);background:#0b1117;border:1px solid var(--line);border-radius:7px}.field-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.case{margin-top:16px;border:1px solid #78bfff44;background:#78bfff0a;border-radius:10px;padding:14px}.case strong{color:var(--blue);font-size:11px;letter-spacing:.12em}.case p{color:var(--muted);font-size:12px;line-height:1.6;margin:8px 0 0}
footer{padding-top:18px;margin-top:18px;border-top:1px solid var(--line);color:#71808f;font-size:10px;line-height:1.6}
@media(max-width:850px){.grid{grid-template-columns:1fr}.hero{align-items:start;flex-direction:column}.live{align-self:flex-start}}
@media(max-width:560px){.wrap{padding:14px 12px 35px}.panel{padding:14px}.field-row,.test-grid{grid-template-columns:1fr}.stage-head{flex-direction:column}.brand strong{font-size:14px}}
:focus-visible{outline:2px solid var(--amber);outline-offset:3px}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
</style>
</head>
<body><div class="wrap">
<header><div class="brand"><div class="hound-mark">⌁</div><div><strong>WIRINGHOUND</strong><small>IRONKNUCKLE // NETWORK DIAGNOSTICS</small></div></div><a class="back" href="./index.html">← MAIN WORKSPACE</a></header>
<section class="hero"><div><div class="eyebrow">J1939 network fault isolation</div><h1>Track the fault.<br>Hunt the cause.</h1><p>A guided, evidence-first workflow for CAN voltage dropouts, resistance checks, module isolation and harness faults. Follow the test sequence. Record what changes. Let the evidence narrow the hunt.</p></div><div class="live">● FIELD WORKFLOW // BETA</div></section>
<div class="disclaimer"><b>TECHNICAL GUARDRAIL:</b> This is a guided workflow based on the field method currently documented—not an OEM-specific procedure. Confirm vehicle topology, test points, safe isolation steps and specifications for the exact vehicle. Do not use resistance mode on an energized circuit. A reading alone does not identify a failed component.</div>
<div class="grid">
<aside class="panel"><h2>Hunt sequence</h2><p class="sub">Work through each stage. Entries save in this browser profile; export a JSON copy for a separate backup.</p><div class="progress" id="progress"></div><div class="step-list" id="stepList"></div><p class="note">The VECU is retained during the key-on isolation stage in the field method described. Vehicle-specific architecture may differ.</p></aside>
<main class="panel"><div id="stage"></div></main>
</div>
<section class="case"><strong>FIELD CASE // CAB HARNESS WATER INTRUSION</strong><p>Example sequence: CAN H and CAN L both fell below 1V after key-on; initial key-off resistance was 60Ω. Other modules were isolated while retaining the VECU, with no change. With all modules disconnected, resistance measured about 1 MΩ. Separating the chassis harness did not change the result. Manipulating the cab harness near the driver's floor made resistance fluctuate. Inspection found a pinhole in the harness insulation and water intrusion beneath the floor mat. This is a technician-reported case—not a universal expected-value rule.</p></section>
<footer>WiringHound is a diagnostic reasoning aid. Readings and decision branches must be interpreted in the context of the vehicle's network design and approved service information. Save confirmed cases with vehicle configuration, test conditions, actual readings and repair evidence.</footer>
</div>
<script>
const steps=[
{title:"Establish the symptom",kicker:"01 // baseline",copy:"Start by reproducing the communication problem and checking both CAN legs against a known-good common ground.",body:()=>`
<div class="test-card"><h3>Key ON // DC volts</h3><div class="test-grid"><div class="test-cell"><b>CAN HIGH → GROUND</b><span>Record actual voltage and whether it stays present.</span></div><div class="test-cell"><b>CAN LOW → GROUND</b><span>Record actual voltage and whether it stays present.</span></div></div><p>Use the same known-good ground reference for both measurements. Observe the readings through the key cycle; note whether either leg or both legs drop out.</p></div>
<div class="field-row"><div class="field"><label for="vh">CAN H voltage (V)</label><input id="vh" inputmode="decimal" placeholder="Actual reading"></div><div class="field"><label for="vl">CAN L voltage (V)</label><input id="vl" inputmode="decimal" placeholder="Actual reading"></div></div>
<div class="field"><label for="vstate">What happened after key-on?</label><select id="vstate"><option value="">Select observation</option><option value="stable">Both readings remain present / stable</option><option value="drop-both">Both legs drop out / fall very low</option><option value="drop-one">Only one leg drops or behaves abnormally</option><option value="intermittent">Intermittent / changes with key cycle</option></select></div>`},
{title:"Key-off resistance",kicker:"02 // network check",copy:"Turn the key off and perform the resistance check across CAN High and CAN Low using the appropriate test points and vehicle procedure.",body:()=>`
<div class="test-card"><h3>Key OFF // ohms</h3><p>Measure CAN H to CAN L. Record the actual value and the network connection state. A value around 60Ω can be consistent with two 120Ω terminators in parallel on some high-speed CAN networks, but topology and OEM test method matter.</p></div>
<div class="field"><label for="rinitial">Initial CAN H ↔ CAN L resistance (Ω)</label><input id="rinitial" inputmode="decimal" placeholder="Enter measured value"></div>
<div class="field"><label for="rstate">Initial interpretation</label><select id="rstate"><option value="">Select observation</option><option value="about60">Approximately 60Ω under this test setup</option><option value="low">Lower than expected</option><option value="high">Higher than expected / open</option><option value="unstable">Unstable / fluctuating</option><option value="unknown">Not sure / needs vehicle-specific spec</option></select></div>`},
{title:"Remove add-on devices",kicker:"03 // first isolation",copy:"Before chasing vehicle modules, isolate aftermarket or added devices that may be connected to the data link.",body:()=>`
<div class="test-card"><h3>First suspects // add-on equipment</h3><p>Isolate the ELD, data logger or other add-on equipment connected to the network. Recheck the original symptom under the same key-on conditions.</p></div>
<div class="field"><label for="eld">After ELD / data logger isolation</label><select id="eld"><option value="">Select result</option><option value="restored">Voltage behavior returns to normal</option><option value="same">No change — dropout remains</option><option value="not-present">No add-on device present</option></select></div>`},
{title:"Isolate modules",kicker:"04 // narrow the network",copy:"If the dropout remains, isolate network modules one at a time, repeating the same key-on voltage observation after each change.",body:()=>`
<div class="test-card"><h3>VECU retained // key-on test</h3><p>In the field method described, the VECU must remain connected for the key to operate and circuits to power up. Disconnect other modules one at a time, following the correct vehicle isolation procedure, and watch for the dropout to clear.</p></div>
<div class="field"><label for="moduleResult">What happened as modules were isolated?</label><select id="moduleResult"><option value="">Select result</option><option value="restored">Voltage returned when a particular module was disconnected</option><option value="same">Dropout remained with only VECU connected</option><option value="uncertain">Result unclear / could not reproduce</option></select></div>
<div class="field"><label for="moduleName">Module that changed the result (if known)</label><input id="moduleName" placeholder="Record module / connector / location"></div>
<div class="note">If voltage recovers when a module is disconnected, that is a lead—not proof the module itself is defective. Check its branch wiring, connector, power and ground before condemning it.</div>`},
{title:"All modules disconnected",kicker:"05 // wiring vs connected loads",copy:"With all network modules disconnected and the circuit in the correct unpowered state, check resistance between CAN H and CAN L again.",body:()=>`
<div class="test-card"><h3>All modules isolated // key OFF</h3><p>The field case you described produced OL as the expected result for this particular fully isolated test. If resistance remains, investigate unintended connections or a wiring path between the conductors. Confirm the topology and test points before interpreting.</p></div>
<div class="field"><label for="rall">Resistance CAN H ↔ CAN L</label><input id="rall" inputmode="decimal" placeholder="e.g. OL, 1 MΩ, 0.4 Ω"></div>
<div class="field"><label for="allState">Observed result</label><select id="allState"><option value="">Select result</option><option value="ol">OL / open circuit</option><option value="finite">Finite resistance remains</option><option value="short">Very low resistance / near short</option><option value="unstable">Reading unstable</option></select></div>
<div class="note">A finite reading does not by itself prove a shorted wire. Something may remain connected, there may be a branch or termination path, or the harness may be damaged. Verify complete isolation and segment boundaries.</div>`},
{title:"Split cab & chassis",kicker:"06 // divide and conquer",copy:"Separate the chassis harness from the cab harness at the appropriate connector or junction. Repeat the same resistance test on each isolated side.",body:()=>`
<div class="test-card"><h3>Segment the network</h3><p>Record which side retains the abnormal reading. Use the correct connector identification and pinout for the vehicle; do not guess connector pins.</p></div>
<div class="field"><label for="segment">Where did the abnormal reading remain?</label><select id="segment"><option value="">Select segment</option><option value="cab">Cab harness</option><option value="chassis">Chassis harness</option><option value="both">Both sides / more than one path</option><option value="neither">Neither side after separation</option><option value="unknown">Unable to isolate clearly</option></select></div>`},
{title:"Wiggle & localize",kicker:"07 // find the physical spot",copy:"Keep the meter connected to the isolated circuit and carefully manipulate accessible harness sections while watching the resistance reading.",body:()=>`
<div class="test-card"><h3>Harness manipulation test</h3><p>Work methodically through accessible sections. Note where the reading changes—not just that it changes. Avoid damaging the harness or disturbing unrelated connectors.</p></div>
<div class="field"><label for="wiggle">What happened during manipulation?</label><select id="wiggle"><option value="">Select observation</option><option value="stable">Reading stayed steady throughout</option><option value="changes">Reading changed near a specific area</option><option value="intermittent">Intermittent change, location not yet isolated</option><option value="none">No change / symptom not reproduced</option></select></div>
<div class="field"><label for="location">Harness area / physical location</label><input id="location" placeholder="e.g. under driver floor, frame rail, clamp point"></div>`},
{title:"Inspect & verify repair",kicker:"08 // prove the cause",copy:"Inspect the localized section for chafing, pinholes, crushed insulation, moisture, corrosion or prior repairs. Confirm the repair by repeating the original tests.",body:()=>`
<div class="test-card"><h3>Physical evidence & repair verification</h3><p>Document what was actually found. After repair, repeat the original key-on voltage and key-off resistance checks using the same test points and conditions. Confirm communication is restored and verify no related faults remain.</p></div>
<div class="field"><label for="cause">Confirmed physical finding</label><select id="cause"><option value="">Select finding</option><option>Chafed / rubbed-through insulation</option><option>Water intrusion / corrosion</option><option>Crushed / pinched harness</option><option>Connector / terminal damage</option><option>Short between conductors</option><option>Other / not yet confirmed</option></select></div>
<div class="field"><label for="repair">Repair performed / verification notes</label><input id="repair" placeholder="Describe repair and final test results"></div>`}
];
const STORAGE_KEY="ironknuckle.wiringhound.v1";
const $=id=>document.getElementById(id);
let saved={};
try{saved=JSON.parse(localStorage.getItem(STORAGE_KEY)||"{}")}catch{saved={}}
let current=Math.min(Number.isInteger(saved.current)?saved.current:0,steps.length-1);
const answers=saved.answers&&typeof saved.answers==="object"?saved.answers:{};
function persist(){try{localStorage.setItem(STORAGE_KEY,JSON.stringify({current,answers,updatedAt:new Date().toISOString()}))}catch(error){console.warn("WiringHound could not save this case locally.",error)}}
function capture(){const box=$("stage");box.querySelectorAll("input,select").forEach(el=>answers[current+"_"+el.id]=el.value);answers[current]=true;persist()}
function restore(){const box=$("stage");box.querySelectorAll("input,select").forEach(el=>{if(answers[current+"_"+el.id]!==undefined)el.value=answers[current+"_"+el.id]})}
function escapeHTML(value){return String(value).replace(/[&<>"']/g,ch=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[ch]))}
function exportHunt(){capture();const payload={product:"IronKnuckle WiringHound",schemaVersion:1,exportedAt:new Date().toISOString(),currentStage:current,answers};const blob=new Blob([JSON.stringify(payload,null,2)],{type:"application/json"});const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download="wiringhound-case-"+new Date().toISOString().slice(0,10)+".json";a.click();URL.revokeObjectURL(url)}
function render(){
 const s=steps[current];
 $("progress").innerHTML=steps.map((_,i)=>'<i class="'+(i<=current?"done":"")+'"></i>').join("");
 $("stepList").innerHTML=steps.map((x,i)=>'<button class="step-nav '+(i===current?"active ":"")+(answers[i]?"complete":"")+'" data-step="'+i+'"><span class="num">'+(answers[i]?"✓":String(i+1).padStart(2,"0"))+'</span><span>'+escapeHTML(x.title)+'</span></button>').join("");
 $("stage").innerHTML='<div class="stage-head"><div><div class="stage-kicker">'+escapeHTML(s.kicker)+'</div><h2 class="stage-title">'+escapeHTML(s.title)+'</h2><p class="stage-copy">'+escapeHTML(s.copy)+'</p></div><span class="tag">STAGE '+(current+1)+' / '+steps.length+'</span></div>'+s.body()+'<div class="actions"><button class="reset" id="reset">Reset hunt</button><button class="next" id="save">Save stage notes</button><button class="next" id="export">Export case JSON</button><button class="next" id="prev" '+(current===0?"disabled":"")+'>← Previous</button><button class="next" id="next">'+(current===steps.length-1?"Review hunt":"Next stage →")+'</button></div><div id="feedback" aria-live="polite"></div>';
 document.querySelectorAll("[data-step]").forEach(b=>b.onclick=()=>{capture();current=Number(b.dataset.step);persist();render()});
 $("save").onclick=()=>{capture();$("feedback").innerHTML='<div class="result"><strong>NOTES SAVED.</strong> This investigation is stored in this browser profile. Export a JSON copy for a separate backup.</div>'};
 $("export").onclick=exportHunt;
 $("prev").onclick=()=>{capture();current=Math.max(0,current-1);persist();render()};
 $("next").onclick=()=>{capture();if(current<steps.length-1){current++;persist();render()}else review()};
 $("reset").onclick=()=>{if(confirm("Clear all WiringHound entries saved in this browser and restart?")){Object.keys(answers).forEach(k=>delete answers[k]);current=0;localStorage.removeItem(STORAGE_KEY);render()}};
 restore();
}
function review(){
 const lines=steps.map((s,i)=>'<li><b>'+escapeHTML(s.title)+':</b> '+Object.keys(answers).filter(k=>k.startsWith(i+"_")).map(k=>answers[k]).filter(Boolean).map(escapeHTML).join(" · ")+'</li>').join("");
 $("feedback").innerHTML='<div class="result"><strong>HUNT REVIEW</strong><ol>'+lines+'</ol><p>Review the evidence and verify the original complaint. This record is not a confirmed diagnosis unless the physical cause and repair have been verified.</p><button class="choice" id="backToReview">Back to final stage</button><button class="choice" id="exportReview">Export case JSON</button></div>';
 $("backToReview").onclick=()=>render();
 $("exportReview").onclick=exportHunt;
}
render();
</script></body></html>