<g class="testpoint" data-point="rightInput" tabindex="0" role="button"><circle cx="970" cy="445" r="6" fill="#ff9f1c"/><text x="980" y="435" class="callout">RIGHT TAIL IN</text></g>
<g class="testpoint" data-point="rightGround" tabindex="0" role="button"><circle cx="970" cy="545" r="6" fill="#61a9df"/><text x="980" y="537" class="callout">RIGHT GND</text></g>
