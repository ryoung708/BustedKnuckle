</svg></div></div>
<div class="legend"><span><i class="key"></i> Energized path</span><span><i class="key blue"></i> Ground return</span><span><i class="key gray"></i> Inactive / unselected</span></div>
<div class="below"><h2>Physical components & test locations</h2><div class="points"><div class="point"><b>Battery box</b>Supply and negative return</div><div class="point"><b>Lighting fuse</b>Branch protection</div><div class="point"><b>Cab switch</b>Tail-light control</div><div class="point"><b>Rear lamps</b>Parallel loads and grounds</div></div><p class="note">Select a component on either view to inspect its role. Both views represent the same simplified training circuit.</p></div></main>
<aside class="panel"><h2>Bench controls</h2><div class="controls">
<label class="toggle"><span>Tail / marker lights</span><input id="tailToggle" type="checkbox"></label>
<label class="toggle"><span>Brake lights</span><input id="brakeToggle" type="checkbox"></label>
<div class="field"><label for="faultSelect">Insert training fault</label><select id="faultSelect"><option value="none">Healthy circuit</option><option value="openFeed">Open feed</option><option value="poorGround">High-resistance ground</option><option value="openGround">Open ground</option></select></div>
<div class="field"><label>Choose active meter lead</label><div style="display:grid;grid-template-columns:1fr 1fr;gap:7px"><button id="selectRed" type="button" class="lead-select active-lead">Red lead</button><button id="selectBlack" type="button" class="lead-select">Black lead</button></div><small id="probeHint" style="display:block;color:var(--muted);margin-top:7px">Red lead selected · click a test point.</small></div><div class="field"><label>Selected test points</label><div id="probeSummary" class="point">Red: Battery positive<br>Black: Battery negative</div><button id="resetProbes" type="button" style="width:100%;margin-top:7px">Reset lead positions</button></div>
<div class="meter"><small>VIRTUAL METER · DC VOLTS</small><div class="reading" id="reading">12.6 V</div><small id="meterCaption">RED: BATTERY POSITIVE · BLACK: BATTERY NEGATIVE</small></div>
</div><div class="explain" id="explain">Select a component to inspect it. Turn on the tail or brake circuit to see the energized path.</div><div class="status" id="status">System: 12.6V nominal · negative-ground · simplified resistive training model.</div></aside></div>
</div>
<script>
(()=>{
const $=id=>document.getElementById(id);
const state={tail:false,brake:false,fault:"none",selected:"battery",view:"both",activeLead:"red",redPoint:"battery",blackPoint:"negative"};
const pointNames={battery:"Battery positive",negative:"Battery negative",fuseIn:"Tail fuse input",fuseOut:"Tail fuse output",switchIn:"Tail switch input",switchOut:"Tail switch output",splice:"Tail-light splice",leftBranch:"Left tail branch",rightBranch:"Right tail branch",leftInput:"Left lamp tail input",leftGround:"Left lamp ground",rightInput:"Right lamp tail input",rightGround:"Right lamp ground",ground:"Common ground",brakeFuseIn:"Brake fuse input",brakeFuseOut:"Brake fuse output",brakeSwitchIn:"Brake pedal switch input",brakeSwitchOut:"Brake pedal switch output",brakeSplice:"Brake-light splice",brakeLeft:"Left brake branch",brakeRight:"Right brake branch"};
const pointCoords={battery:[215,230],negative:[215,285],fuseIn:[365,218],fuseOut:[490,218],switchIn:[535,218],switchOut:[660,218],splice:[245,345],leftBranch:[245,469],rightBranch:[755,469],leftInput:[201,469],leftGround:[245,495],rightInput:[711,469],rightGround:[755,495],ground:[755,455],brakeFuseIn:[365,270],brakeFuseOut:[490,270],brakeSwitchIn:[535,300],brakeSwitchOut:[660,300],brakeSplice:[500,380],brakeLeft:[245,420],brakeRight:[755,420]};
const details={brakeFuse:"Separate protected 12V supply for the brake-light circuit.",brakeSwitch:"Brake pedal switch: closes when the pedal is applied and supplies the brake-light branch independently of the tail-light switch.",battery:"Battery box: nominal 12.6V supply with a negative return. The simulator uses an idealized source for this first training build.",fuse:"Lighting fuse: protects the branch against excessive current. The open-feed fault is placed downstream of the fuse in this introductory model.",switch:"Cab light switch: controls the tail/marker branch. Brake control is represented separately for this first-stage lesson.",leftLamp:"Left rear lamp assembly: parallel tail and brake loads share a ground return.",rightLamp:"Right rear lamp assembly: parallel tail and brake loads share a ground return."};
function nodeVoltage(point){
 const feedOpen=state.fault==="openFeed",groundOpen=state.fault==="openGround";
 if(point==="negative")return 0;
 if(point==="battery")return 12.6;
 if(point==="ground")return groundOpen?12.6:(state.fault==="poorGround"&& (state.tail||state.brake)?0.9:0.02);
 const active=state.tail||state.brake;
 if(point==="fuseOut"||point==="brakeFuseOut")return feedOpen?0:12.58;
 if(point==="brakeSwitchOut"||point==="brakeSplice"||point==="brakeLeft"||point==="brakeRight")return state.brake&&!feedOpen?12.4:0;
 if(point==="brakeFuseIn"||point==="brakeSwitchIn")return 12.6;
 if(point==="switchOut")return feedOpen?0:(state.tail?12.45:0);
 if(point==="leftLamp")return feedOpen?0:(active?12.3:0);
 return 0;
}
function update(){
 const feedOpen=state.fault==="openFeed",groundBad=state.fault==="poorGround"||state.fault==="openGround";
 const tailOn=state.tail&&!feedOpen&&!groundBad,brakeOn=state.brake&&!feedOpen&&!groundBad;
 ["leftTail","rightTail","schLeftTail","schRightTail"].forEach(id=>document.querySelectorAll("#"+id).forEach(el=>el.classList.toggle("on",tailOn)));
 ["leftBrake","rightBrake","schLeftBrake","schRightBrake"].forEach(id=>document.querySelectorAll("#"+id).forEach(el=>el.classList.toggle("on",brakeOn)));
 ["physPower","harness","schFeed","schAfterFuse","schTail"].forEach(id=>document.querySelectorAll("#"+id).forEach(el=>el.classList.toggle("hot",(state.tail||state.brake)&&!feedOpen)));
 ["physBrakeFeed","schBrakeFeed","schBrakeAfterFuse","schBrake"].forEach(id=>document.querySelectorAll("#"+id).forEach(el=>el.classList.toggle("hot",state.brake&&!feedOpen)));
 ["physGround","schGround"].forEach(id=>document.querySelectorAll("#"+id).forEach(el=>el.classList.toggle("hot",(state.tail||state.brake)&&!groundBad)));
 const red=state.redPoint,black=state.blackPoint;
 const volts=Math.abs(nodeVoltage(red)-nodeVoltage(black));
 $("reading").textContent=volts.toFixed(2)+" V";
 $("meterCaption").textContent="RED: "+pointNames[red].toUpperCase()+" · BLACK: "+pointNames[black].toUpperCase();
 $("probeSummary").innerHTML='<b style="color:#ff8b7b">Red:</b> '+pointNames[red]+'<br><b style="color:#83c5f2">Black:</b> '+pointNames[black];
 drawProbeLeads();
 $("explain").textContent=state.selected&&details[state.selected]?details[state.selected]:state.fault==="poorGround"?"High-resistance ground inserted: the simplified model shows a raised ground-side potential when the lighting load is commanded on.":state.fault==="openGround"?"Open ground inserted: the return path is interrupted. A real diagnostic sequence would verify the ground path under load.":state.fault==="openFeed"?"Open feed inserted downstream of branch protection. Compare voltage before and after the interruption.":"Select a component to inspect it. Turn on the tail or brake circuit to see the energized path.";
 if(state.fault!=="none")$("status").textContent="Training fault active: "+$("faultSelect").selectedOptions[0].text+". Readings are illustrative, not OEM specifications.";
 else $("status").textContent="System: 12.6V nominal · negative-ground · simplified resistive training model.";
}
function drawProbeLeads(){
 const views=[
  {svg:$("physicalSvg"),coords:pointCoords},
  {svg:$("schematicSvg"),coords:{battery:[155,325],negative:[155,440],fuseIn:[290,209],fuseOut:[405,209],switchIn:[480,209],switchOut:[635,209],splice:[820,250],leftBranch:[930,235],rightBranch:[930,445],leftInput:[970,235],leftGround:[970,335],rightInput:[970,445],rightGround:[970,545],ground:[970,620],brakeFuseIn:[290,289],brakeFuseOut:[405,289],brakeSwitchIn:[480,289],brakeSwitchOut:[635,289],brakeSplice:[820,425],brakeLeft:[970,285],brakeRight:[970,495]}}
 ];
 views.forEach(({svg,coords})=>{
  if(!svg)return;
  const r=coords[state.redPoint]||coords.battery,b=coords[state.blackPoint]||coords.negative;
  const prefix=svg.id==="schematicSvg"?"schematic_":"";
  const el=id=>svg.querySelector("#"+prefix+id);
  const redPath=el("redLeadPath"),blackPath=el("blackLeadPath"),redTip=el("redProbeTip"),blackTip=el("blackProbeTip"),redTag=el("redProbeTag"),blackTag=el("blackProbeTag");
  if(!redPath||!blackPath||!redTip||!blackTip||!redTag||!blackTag)return;
  redPath.setAttribute("d","M470 525 Q"+((470+r[0])/2-25)+" "+Math.max(25,(525+r[1])/2-35)+" "+r[0]+" "+r[1]);
  blackPath.setAttribute("d","M530 525 Q"+((530+b[0])/2+25)+" "+Math.max(25,(525+b[1])/2-20)+" "+b[0]+" "+b[1]);
  redTip.setAttribute("cx",r[0]);redTip.setAttribute("cy",r[1]);
  blackTip.setAttribute("cx",b[0]);blackTip.setAttribute("cy",b[1]);
  redTag.setAttribute("x",Math.min(930,r[0]+12));redTag.setAttribute("y",r[1]-12);
  blackTag.setAttribute("x",Math.min(930,b[0]+12));blackTag.setAttribute("y",b[1]+20);
 });
 $("probeHint").textContent=(state.activeLead==="red"?"Red":"Black")+" lead selected · click a labeled test point. Both views stay synchronized.";
}
function chooseProbe(point){if(state.activeLead==="red")state.redPoint=point;else state.blackPoint=point;update();}
function chooseNode(el){state.selected=el.dataset.node;document.querySelectorAll(".node").forEach(n=>n.classList.toggle("selected",n.dataset.node===state.selected));$("explain").textContent=details[state.selected]||"Selected test location."; }
document.querySelectorAll(".node").forEach(el=>{el.addEventListener("click",()=>chooseNode(el));el.addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();chooseNode(el)}})});
$("tailToggle").addEventListener("change",e=>{state.tail=e.target.checked;state.selected=null;update()});
$("brakeToggle").addEventListener("change",e=>{state.brake=e.target.checked;state.selected=null;update()});
$("faultSelect").addEventListener("change",e=>{state.fault=e.target.value;state.selected=null;update()});
document.querySelectorAll(".testpoint").forEach(p=>{p.addEventListener("click",()=>chooseProbe(p.dataset.point));p.addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();chooseProbe(p.dataset.point);}})});$("selectRed").addEventListener("click",()=>{state.activeLead="red";$("selectRed").classList.add("active-lead");$("selectBlack").classList.remove("active-lead");drawProbeLeads()});$("selectBlack").addEventListener("click",()=>{state.activeLead="black";$("selectBlack").classList.add("active-lead");$("selectRed").classList.remove("active-lead");drawProbeLeads()});$("resetProbes").addEventListener("click",()=>{state.redPoint="battery";state.blackPoint="negative";update()});
function setView(){drawProbeLeads();}
$("resetBtn").addEventListener("click",()=>{state.tail=false;state.brake=false;state.fault="none";state.selected="battery";$("tailToggle").checked=false;$("brakeToggle").checked=false;$("faultSelect").value="none";state.redPoint="battery";state.blackPoint="negative";document.querySelectorAll(".node").forEach(n=>n.classList.remove("selected"));setView("physical");update()});
update();drawProbeLeads();
})();
</script>
</body></html>