<!-- ======================================================== -->
<!-- IRONKNUCKLE DIAGNOSTICS // INDEX.HTML SECTION 1 OF 3      -->
<!-- PLATFORM LAYOUT & PREMIUM STEALTH-TITANIUM STYLING       -->
<!-- ======================================================== -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>IronKnuckle Diagnostics</title>
  <style>
    :root {
      --slate-black: #08090a;
      --deep-titanium: #111316;
      --control-charcoal: #1a1d22;
      --border-tint: #2c323b;
      --nitrogen-amber: #ff9f1c;
      --text-bright: #f0f2f5;
      --text-muted: #7e8b9b;
    }

    body {
      background-color: var(--slate-black);
      color: var(--text-bright);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    .master-wrapper {
      max-width: 1400px;
      margin: 0 auto;
      padding: 24px;
      box-sizing: border-box;
    }

    /* HEADER SPACE CONTROLS */
    .premium-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 32px;
      border-bottom: 2px solid var(--border-tint);
      padding-bottom: 32px;
      margin-bottom: 32px;
    }

    @media (min-width: 768px) {
      .premium-header {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }
    }

    .brand-logo-img {
      height: 180px; 
      width: auto;
      max-width: 100%;
      object-fit: contain;
      filter: drop-shadow(0 0 20px rgba(255, 159, 28, 0.35));
    }

    .platform-selector-pill {
      background-color: var(--control-charcoal);
      border: 1px solid var(--border-tint);
      color: var(--text-bright);
      font-weight: bold;
      padding: 14px 20px;
      border-radius: 6px;
      font-size: 14px;
      outline: none;
      cursor: pointer;
    }

    /* DUAL MODE SELECTION SWITCHES */
    .mode-nav-bar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 24px;
    }

    .mode-tab-button {
      background-color: var(--deep-titanium);
      border: 2px solid var(--border-tint);
      color: var(--text-muted);
      padding: 16px;
      font-size: 16px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      border-radius: 6px;
      cursor: pointer;
      text-align: center;
      transition: all 0.2s ease;
    }

    .mode-tab-button.active {
      border-color: var(--nitrogen-amber);
      color: var(--nitrogen-amber);
      background-color: #1e1910;
    }

    /* SEARCH ENGINE CONTROLS */
    .search-container {
      width: 100%;
      margin-bottom: 24px;
    }

    .live-search-input {
      width: 100%;
      background-color: var(--deep-titanium);
      border: 2px solid var(--border-tint);
      border-radius: 8px;
      padding: 18px 24px;
      box-sizing: border-box;
      color: var(--text-bright);
      font-size: 18px;
      font-weight: bold;
      outline: none;
    }

    .live-search-input:focus {
      border-color: var(--nitrogen-amber);
      box-shadow: 0 0 15px rgba(255, 159, 28, 0.15);
    }

    .live-search-input::placeholder {
      color: var(--text-muted);
    }

    .workspace-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
    }

    @media (min-width: 992px) {
      .workspace-layout {
        grid-template-columns: 1.1fr 0.9fr;
      }
    }

    .interactive-card-group {
      background-color: var(--deep-titanium);
      border: 1px solid var(--border-tint);
      border-radius: 8px;
      padding: 20px;
    }

    .card-block-title {
      font-size: 13px;
      text-transform: uppercase;
      font-weight: 800;
      letter-spacing: 1px;
      color: var(--text-muted);
      margin-bottom: 16px;
    }

    .engine-fault-button-list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .premium-target-btn {
      background-color: var(--control-charcoal);
      border: 1px solid var(--border-tint);
      padding: 18px 20px;
      border-radius: 6px;
      cursor: pointer;
      text-align: left;
    }

    .premium-target-btn.active-node {
      border-color: var(--nitrogen-amber);
      background-color: #261b0c;
    }

    .btn-fault-id {
      font-size: 18px;
      font-weight: 800;
      color: var(--text-bright);
    }

    .premium-target-btn.active-node .btn-fault-id {
      color: var(--nitrogen-amber);
    }

    .btn-fault-info {
      font-size: 13px;
      color: var(--text-muted);
      margin-top: 6px;
      line-height: 1.4;
    }

    /* TRIAGE VAULT MATRIX STYLING */
    .diagnostic-matrix-vault {
      background-color: var(--deep-titanium);
      border: 1px solid var(--border-tint);
      border-radius: 8px;
      padding: 24px;
      align-self: start;
    }

    .diagnostic-matrix-vault.active-triage {
      border-color: var(--nitrogen-amber);
    }

    .status-matrix-banner {
      background-color: var(--control-charcoal);
      border: 1px solid var(--border-tint);
      color: var(--text-muted);
      font-weight: 800;
      font-size: 13px;
      padding: 12px;
      border-radius: 4px;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 24px;
    }

    .status-matrix-banner.alert-active {
      background-color: var(--nitrogen-amber);
      color: var(--slate-black);
      border-color: var(--nitrogen-amber);
    }

    .matrix-node-segment {
      margin-bottom: 24px;
    }

    .matrix-node-segment h4 {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
      margin: 0 0 10px 0;
    }

    .circuit-value-display {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-bright);
      line-height: 1.5;
    }

    .bullet-action-stream {
      padding-left: 18px;
      margin: 8px 0 0 0;
    }

    .bullet-action-stream li {
      font-size: 14px;
      line-height: 1.5;
      color: var(--text-bright);
      margin-bottom: 10px;
    }

    .premium-affiliate-anchor {
      display: inline-block;
      background-color: var(--control-charcoal);
      border: 1px solid var(--border-tint);
      color: var(--nitrogen-amber);
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      padding: 12px 16px;
      border-radius: 4px;
      margin-top: 8px;
      margin-right: 8px;
      text-transform: uppercase;
    }
  </style>
</head>
  <!-- ======================================================== -->
<!-- IRONKNUCKLE DIAGNOSTICS // INDEX.HTML SECTION 2 OF 3      -->
<!-- PHYSICAL HTML ELEMENT PLACEMENT FRAMEWORK                -->
<!-- ======================================================== -->
<body>

  <div class="master-wrapper">
    <!-- HEADER CONTROLS PLACEMENT -->
    <header class="premium-header">
      <div class="brand-logo-frame">
        <img src="logo.png" alt="IronKnuckle Diagnostics" class="brand-logo-img">
      </div>
      <div id="engineFilterSubGroup" style="display: flex; flex-direction: column; gap: 12px;">
        <select class="platform-selector-pill" id="engineSelect">
          <option value="mack_mp8">MACK MP8 (13L PLATFORM)</option>
          <option value="mack_mp7">MACK MP7 (11L PLATFORM)</option>
          <option value="mack_mp10">MACK MP10 (16L HEAVY-HAUL)</option>
        </select>
        <select class="platform-selector-pill" id="emissionSelect"></select>
      </div>
    </header>

    <!-- NAVIGATION TABS COMPONENT -->
    <nav class="mode-nav-bar">
      <div class="mode-tab-button active" id="tabFaultMode">Fault Code Tracker</div>
      <div class="mode-tab-button" id="tabSymptomMode">Symptom Trees</div>
    </nav>

    <!-- INTERACTIVE INPUT: FILTER SYSTEM SEARCH BAR -->
    <div class="search-container">
      <input type="text" id="liveSearch" class="live-search-input" placeholder="SEARCH ACTIVE CODES...">
    </div>

    <!-- MAIN PANELS SPLIT WORKSPACE WINDOWS -->
    <main class="workspace-layout">
      
      <!-- ENGINE DATA BLOCKS SELECTOR MOUNT (LEFT SIDE) -->
      <section class="interactive-card-group">
        <div class="card-block-title" id="listBlockTitle">Select Active Bay Fault Stacking Sequence</div>
        <div class="engine-fault-button-list" id="faultListContainer"></div>
      </section>

      <!-- DIAGNOSTIC ANALYSIS ENGINE DISPLAY VAULT (RIGHT SIDE) -->
      <section class="diagnostic-matrix-vault" id="matrixVault" style="opacity: 0.25; pointer-events: none;">
        <div class="status-matrix-banner" id="priorityIndicator">SYSTEM RUNNING MONITOR</div>
        
        <div class="matrix-node-segment" id="circuitSegmentFrame">
          <h4>Shared Loop Core Intersect</h4>
          <div class="circuit-value-display" id="circuitDisplay"></div>
        </div>

        <div class="matrix-node-segment">
          <h4 id="actionTargetLabel">Probable Diagnostic Targets</h4>
          <ul class="bullet-action-stream" id="culpritDisplayList"></ul>
        </div>

        <div class="matrix-node-segment">
          <h4>Specialized Tooling Manifest</h4>
          <div id="toolLinkManifestContainer"></div>
        </div>
      </section>

    </main>
  </div>
  <!-- ======================================================== -->
<!-- IRONKNUCKLE DIAGNOSTICS // INDEX.HTML SECTION 3 OF 3      -->
<!-- INTERACTIVE JAVASCRIPT CONTROLLER EXECUTOR                -->
<!-- ======================================================== -->
  <script type="module">
    import { BustedKnuckleCore } from './js/app.js';
    import { faultCodeDatabase, globalFaultLibrary } from './js/database.js';

    let activeSystemMode = 'fault_code'; 
    let currentSelectorKey = 'mack_mp8';
    let currentEmissionKey = 'us10_us14';
    const appRuntime = new BustedKnuckleCore(currentSelectorKey);

    const engineWidget = document.getElementById('engineSelect');
    const emissionWidget = document.getElementById('emissionSelect');
    const filterContainerBlock = document.getElementById('engineFilterSubGroup');
    const listContainer = document.getElementById('faultListContainer');
    const matrixVault = document.getElementById('matrixVault');
    const searchInput = document.getElementById('liveSearch');
    
    const btnFaultMode = document.getElementById('tabFaultMode');
    const btnSymptomMode = document.getElementById('tabSymptomMode');
    const listBlockTitle = document.getElementById('listBlockTitle');

    // MANAGEMENT TERMINAL: NAVIGATION INTERCEPT TABS
    btnFaultMode.onclick = () => {
      activeSystemMode = 'fault_code';
      btnFaultMode.classList.add('active');
      btnSymptomMode.classList.remove('active');
      filterContainerBlock.style.visibility = 'visible';
      listBlockTitle.innerText = "Select Active Bay Fault Stacking Sequence";
      searchInput.placeholder = "SEARCH ACTIVE CODES... (e.g. SPN 4364, P205B)";
      searchInput.value = '';
      renderContentBlocks();
      clearDisplayMatrix();
    };

    btnSymptomMode.onclick = () => {
      activeSystemMode = 'symptom';
      btnSymptomMode.classList.add('active');
      btnFaultMode.classList.remove('active');
      filterContainerBlock.style.visibility = 'hidden'; 
      listBlockTitle.innerText = "Select Observed Vehicle Operating Malfunction";
      searchInput.placeholder = "SEARCH SYMPTOMS... (e.g. No Start, Power Loss)";
      searchInput.value = '';
      renderContentBlocks();
      clearDisplayMatrix();
    };

    // MANAGEMENT TERMINAL: ENGINE AND EMISSIONS PICK FILTERS
    engineWidget.addEventListener('change', (e) => {
      currentSelectorKey = e.target.value;
      appRuntime.setEnginePlatform(currentSelectorKey);
      populateEmissionDropdown();
      searchInput.value = ''; 
      renderContentBlocks();
      clearDisplayMatrix();
    });

    emissionWidget.addEventListener('change', (e) => {
      currentEmissionKey = e.target.value;
      searchInput.value = '';
      renderContentBlocks();
      clearDisplayMatrix();
    });

    // RUNTIME AUXILIARY: REAL TIME STRING LOOKUP FILTER MATCHING
    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();
      const cardNodes = listContainer.getElementsByClassName('premium-target-btn');
      Array.from(cardNodes).forEach(card => {
        if (card.innerText.toLowerCase().includes(query)) card.style.display = 'block';
        else card.style.display = 'none';
      });
    });

    function populateEmissionDropdown() {
      emissionWidget.innerHTML = '';
      const levels = faultCodeDatabase.engines[currentSelectorKey].emission_levels;
      Object.keys(levels).forEach((key, idx) => {
        if (idx === 0) currentEmissionKey = key;
        const opt = document.createElement('option');
        opt.value = key;
        opt.innerText = levels[key].toUpperCase();
        emissionWidget.appendChild(opt);
      });
    }

       // ========================================================
    // UPDATE: NEW LIGHTWEIGHT CROSS-PLATFORM MAPPING ROUTINE
    // PLACE THIS INSIDE INDEX.HTML INSTEAD OF THE OLD RENDER FUNCTIONS
    // ========================================================
    function renderActiveFaultBlocks() {
      listContainer.innerHTML = '';
      
      // Pull down the active engine's code map registry
      const engineManifest = faultCodeDatabase.engines[currentSelectorKey].code_manifest;
      if (!engineManifest) return;

      engineManifest.forEach(manifestItem => {
        // FILTER GATEWAY: Only build codes matching the active emissions dropdown selection tier
        if (manifestItem.emission_level !== currentEmissionKey) return;

        // GLOBAL KEY LOOKUP: Pull common failure specs instantly out of our shared repository library
        const structuralRecord = globalFaultLibrary[manifestItem.code_id];
        if (!structuralRecord) return;

        const btnNode = document.createElement('div');
        btnNode.className = 'premium-target-btn';
        btnNode.dataset.key = manifestItem.code_id;

        const primaryId = structuralRecord.p_code !== "N/A" 
          ? `${structuralRecord.p_code} (SPN ${structuralRecord.spn})` 
          : `SPN ${structuralRecord.spn} // FMI ${structuralRecord.fmi}`;

        btnNode.innerHTML = `
          <div class="btn-fault-id">${primaryId}</div>
          <div class="btn-fault-info">${structuralRecord.description}</div>
        `;
        
        btnNode.onclick = () => {
          btnNode.classList.toggle('active-node');
          const operationalOutputs = appRuntime.toggleFaultCode(manifestItem.code_id);
          processOutputMatrix(operationalOutputs);
        };
        listContainer.appendChild(btnNode);
      });
    }

    function processOutputMatrix(matrix) {
      if (!matrix) { clearDisplayMatrix(); return; }
      document.getElementById('circuitSegmentFrame').style.display = 'block';
      document.getElementById('actionTargetLabel').innerText = "Probable Diagnostic Targets";
      matrixVault.style.opacity = '1'; matrixVault.style.pointerEvents = 'auto'; matrixVault.classList.add('active-triage');
      
      const indicator = document.getElementById('priorityIndicator');
      indicator.innerText = matrix.priorityCode; indicator.classList.add('alert-active');

      const circuitDisplay = document.getElementById('circuitDisplay');
      if (matrix.matchedCircuits.length > 0) {
        circuitDisplay.innerHTML = matrix.matchedCircuits.map(c => `<div style="color: var(--nitrogen-amber); margin-bottom: 4px; font-weight: 800;">${c.name}</div><div style="font-size: 13px; color: var(--text-bright); font-weight: normal;">${c.triage_tip}</div>`).join('<br/>');
      } else {
        circuitDisplay.innerHTML = `<span style="color: var(--text-muted); font-weight: normal; font-size: 14px;">No circuit intersections located for this fault sequence.</span>`;
      }
      document.getElementById('culpritDisplayList').innerHTML = matrix.inferredCulprits.map(txt => `<li>${txt}</li>`).join('');
      document.getElementById('toolLinkManifestContainer').innerHTML = matrix.allocatedTools.map(tool => `<a href="${tool.affiliate_url}" target="_blank" class="premium-affiliate-anchor">🛠️ ${tool.name}</a>`).join('');
    }

    function processSymptomOutputMatrix(tree) {
      document.getElementById('circuitSegmentFrame').style.display = 'none'; 
      document.getElementById('actionTargetLabel').innerText = "Step-By-Step Triage Execution Path";
      matrixVault.style.opacity = '1'; matrixVault.style.pointerEvents = 'auto'; matrixVault.classList.add('active-triage');
      
      const indicator = document.getElementById('priorityIndicator');
      indicator.innerText = tree.triage_priority; indicator.classList.add('alert-active');
      
      document.getElementById('culpritDisplayList').innerHTML = tree.steps.map(step => `<li>${step}</li>`).join('');
      document.getElementById('toolLinkManifestContainer').innerHTML = tree.required_tools.map(tId => {
        const tool = faultCodeDatabase.tools[tId];
        return `<a href="${tool.affiliate_url}" target="_blank" class="premium-affiliate-anchor">🛠️ ${tool.name}</a>`;
      }).join('');
    }

    function clearDisplayMatrix() {
      matrixVault.style.opacity = '0.25'; matrixVault.style.pointerEvents = 'none'; matrixVault.classList.remove('active-triage');
      const indicator = document.getElementById('priorityIndicator');
      indicator.innerText = 'SYSTEM RUNNING MONITOR'; indicator.classList.remove('alert-active');
      document.getElementById('circuitDisplay').innerHTML = '';
      document.getElementById('culpritDisplayList').innerHTML = '';
      document.getElementById('toolLinkManifestContainer').innerHTML = '';
    }

    // FIRST LAUNCH INITIALIZATION
    populateEmissionDropdown();
    renderContentBlocks();
  </script>
</body>
</html>


